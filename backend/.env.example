# Copy to .env for local development. NEVER commit real values.
# Postgres connection string (local example). On Render use the database's *Internal* URL.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/biddrive
# Set to true only when using an external (public) managed-Postgres URL that requires TLS.
DATABASE_SSL=false
# REQUIRED in production: random string, >= 32 chars (e.g. `openssl rand -hex 32`). Signs login tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
PORT=8080
NODE_ENV=development
# Demo login (POST /api/auth/demo + seeded demo user). Set to "false" to disable entirely.
ENABLE_DEMO=true
# Set to "false" to skip seeding the sample vehicle catalogue.
SEED_DEMO_DATA=true
# Only for the optional web admin dashboard. Leave EMPTY to disable admin sign-in. >= 16 chars if set.
ADMIN_SECRET=
# Comma-separated browser origins allowed by CORS (the Android app does not need CORS).
CORS_ORIGINS=
